# AuraLink Digital Agency - Environment Variables

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Credentials
# Replace with your Razorpay Key ID and Key Secret from https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Search Engine Verification (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

# ------------------------------------------------------------------------------
# Lead & Contact Form Email Delivery (to hello@auralinkdigitalagency.indevs.in)
# Provide EITHER SMTP_* credentials OR RESEND_API_KEY
# ------------------------------------------------------------------------------
CONTACT_EMAIL=hello@auralinkdigitalagency.indevs.in
MAIL_FROM=AuraLink Digital Agency <hello@auralinkdigitalagency.indevs.in>

# Option A: SMTP (Zoho / Hostinger / Gmail App Password / cPanel)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@auralinkdigitalagency.indevs.in
SMTP_PASS=

# Option B: Resend API (https://resend.com)
RESEND_API_KEY=
