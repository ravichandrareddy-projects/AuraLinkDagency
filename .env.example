# AuraLink Digital Agency - Environment Variables

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Credentials
# Replace with your Razorpay Key ID and Key Secret from https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# Search Engine Verification (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here
